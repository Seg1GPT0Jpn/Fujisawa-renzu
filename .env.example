# ふじさわレンズ 設定キー一覧（値は例。秘密情報はこのファイルに書かない）

# --- 静的サイト（scripts/write-config.mjs が site/config.js に書き込む公開値） ---
# 混雑共有APIの公開URL。空なら混雑共有は「準備中」と表示される。
CROWDING_API_BASE=

# --- 混雑共有API（Cloudflare Workers。worker/wrangler.toml の [vars] または secret で設定） ---
# 投稿を許可する静的サイトのオリジン（カンマ区切り）
ALLOWED_ORIGINS=https://example.github.io
# 集計対象とする報告の有効期間（分）
REPORT_WINDOW_MINUTES=30
# これ未満の報告数では「情報不足」と表示
MIN_REPORTS_FOR_SUMMARY=3
# 同じ送信元から同じ施設への再報告を受け付けない時間（分）
PER_FACILITY_COOLDOWN_MINUTES=10
# 同じ送信元から1時間に受け付ける報告数
PER_CLIENT_HOURLY_LIMIT=10
# 1施設あたり全体で1分間に受け付ける報告数
GLOBAL_PER_FACILITY_PER_MINUTE=30
# 報告データの保存期間（時間）
RETENTION_HOURS=24
# レート制限用ハッシュの秘密値（必須・秘密）。`wrangler secret put RATE_LIMIT_SECRET` で設定し、ファイルには書かない。
RATE_LIMIT_SECRET=

# --- データ取込（プロキシ環境のみ） ---
# Node.js の fetch に HTTPS_PROXY 等を使わせる場合
NODE_USE_ENV_PROXY=1
